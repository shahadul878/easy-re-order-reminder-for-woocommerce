<?xml version="1.0"?>
<ruleset name="Easy Re-Order Reminder for WooCommerce">
	<description>PHPCS configuration for Easy Re-Order Reminder for WooCommerce plugin using official WordPress Coding Standards.

	This configuration runs the WordPress rulesets (Core + Extra + Docs) against the plugin codebase.
	Requires WPCS and its dependencies (PHPCSUtils, PHPCSExtra) to be installed and registered with PHP_CodeSniffer.
	</description>

	<!-- What to scan -->
	<file>easy-reorder-reminder.php</file>
	<file>includes/</file>
	<file>templates/</file>

	<!-- How to scan -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<!-- Use official WordPress Coding Standards -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra">
		<!-- Relax some overly strict comment formatting sniffs -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Squiz.Commenting.FileComment.WrongStyle"/>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="edit_products"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress-Docs"/>

	<!-- Ignore purely recommended nonce verification warnings where we explicitly document safe access -->
	<rule ref="WordPress.Security.NonceVerification">
		<exclude name="WordPress.Security.NonceVerification.Recommended"/>
	</rule>

	<!-- Report width for better readability -->
	<arg name="report-width" value="120"/>
	
	<!-- Show sniff codes in all reports -->
	<arg value="sp"/>
</ruleset>
